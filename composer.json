{
    "name": "observer/gamer-market",
    "description": "Ядро магазина цифровых товаров: платежи, авто-выдача, exactly-once под гонками",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "migrate": "php bin/migrate",
        "seed": "php bin/seed",
        "worker": "php bin/worker",
        "test": "phpunit"
    }
}
