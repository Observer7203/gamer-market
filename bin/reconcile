#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Services\Reconciliation;
use App\Support\Container;

/**
 * Отчёт сверки.
 *
 *   php bin/reconcile          читаемая сводка
 *   php bin/reconcile --json   полный отчёт
 *
 * Ненулевой код возврата означает наличие расхождений.
 */

/** @var Container $container */
$container = require dirname(__DIR__) . '/src/bootstrap.php';

$report = $container->get(Reconciliation::class)->report();

if (in_array('--json', $argv, true)) {
    echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), "\n";
    exit($report['healthy'] ? 0 : 1);
}

printf("Сверка на %s\n\n", $report['generated_at']);

$titles = [
    'orders'                => 'заказов всего',
    'items'                 => 'позиций всего',
    'delivered_items'       => 'позиций выдано',
    'refunded_items'        => 'позиций возвращено',
    'partially_delivered'   => 'заказов выдано частично',
    'paid_not_delivered'    => 'оплачен, но не выдан',
    'delivered_not_paid'    => 'выдан, но не оплачен',
    'stuck_jobs'            => 'зависших задач',
    'unresolved_deliveries' => 'выдач без ответа поставщика',
    'unapplied_events'      => 'непринятых событий',
    'ledger_imbalanced'     => 'несведённых проводок',
    'unsettled_orders'      => 'завершённых с долгом',
    'open_discrepancies'    => 'неразобранных расхождений',
    'unaccepted_codes'      => 'кодов в обход приёмки',
];

$pad = static fn (string $text, int $width): string
    => $text . str_repeat(' ', max(1, $width - mb_strlen($text)));

foreach ($report['summary'] as $key => $value) {
    printf("  %s %s\n", $pad($titles[$key] ?? $key, 32), $value);
}

$money = $report['money'];

echo "\nДеньги, минорные единицы:\n";
printf("  %s %d\n", $pad('оплачено', 32), $money['paid_minor']);
printf("  %s %d\n", $pad('выдано', 32), $money['delivered_minor']);
printf("  %s %d\n", $pad('возвращено', 32), $money['refunded_minor']);
printf("  %s %d\n", $pad('ещё в работе', 32), $money['in_progress_minor']);
printf("  %s %s\n", $pad('оплачено = выдано + возвращено + в работе', 42),
    $money['balanced'] ? 'да' : 'НЕТ');

echo "\nБаланс журнала, минорные единицы:\n";

$total = 0;
foreach ($report['ledger']['balances'] as $account => $amount) {
    printf("  %s %+d\n", $pad($account, 32), $amount);
    $total += $amount;
}
printf("  %s %+d\n", $pad('сумма всех счетов', 32), $total);

if ($report['discrepancies'] !== []) {
    echo "\nРасхождения с поставщиками:\n";

    foreach ($report['discrepancies'] as $kind => $counts) {
        printf("  %s всего %d, открыто %d\n", $pad($kind, 32), $counts['всего'], $counts['открыто']);
    }
}

$sections = [
    'paid_not_delivered'    => 'ОПЛАЧЕН, НО НЕ ВЫДАН',
    'delivered_not_paid'    => 'ВЫДАН, НО НЕ ОПЛАЧЕН',
    'stuck_jobs'            => 'ЗАВИСШИЕ ЗАДАЧИ',
    'unresolved_deliveries' => 'ВЫДАЧИ БЕЗ ОТВЕТА ПОСТАВЩИКА',
    'unapplied_events'      => 'НЕПРИНЯТЫЕ СОБЫТИЯ',
    'ledger_imbalanced'     => 'НЕСВЕДЁННЫЕ ПРОВОДКИ',
    'unsettled_orders'      => 'ЗАВЕРШЁННЫЕ ЗАКАЗЫ С НЕПОГАШЕННЫМ ОБЯЗАТЕЛЬСТВОМ',
    'open_discrepancies'    => 'НЕРАЗОБРАННЫЕ РАСХОЖДЕНИЯ С ПОСТАВЩИКАМИ',
    'unaccepted_codes'      => 'КОДЫ, УШЕДШИЕ В ОБХОД ПРИЁМКИ',
];

foreach ($sections as $key => $title) {
    if ($report[$key] === []) {
        continue;
    }

    printf("\n%s\n", $title);

    foreach ($report[$key] as $row) {
        printf("  %s\n", json_encode($row, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES));
    }
}

printf(
    "\n%s\n",
    $report['healthy'] ? 'Расхождений нет.' : sprintf('Расхождений: %d.', $report['problems'])
);

exit($report['healthy'] ? 0 : 1);
