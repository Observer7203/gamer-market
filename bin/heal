#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Services\HealStuckOrders;
use App\Support\Container;

/**
 * Доводка заказов, не завершившихся самостоятельно.
 *
 * Запускается планировщиком раз в минуту. Все действия идемпотентны,
 * повторный запуск ничего не удваивает.
 */

/** @var Container $container */
$container = require dirname(__DIR__) . '/src/bootstrap.php';

$healed = ($container->get(HealStuckOrders::class))();

// Молчание при отсутствии работы: планировщик выполняет доводку каждую
// минуту, и постоянный вывод забивал бы журнал контейнера.
if (array_sum($healed) === 0 && !in_array('--verbose', $argv, true)) {
    exit(0);
}

printf(
    "возвращено задач: %d, применено событий: %d, отправлено в очередь заказов: %d\n",
    $healed['released_jobs'],
    $healed['applied_events'],
    $healed['requeued_orders'],
);
