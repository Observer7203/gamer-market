DB_DSN=pgsql:host=db;port=5432;dbname=gamer_market
DB_USER=gamer
DB_PASSWORD=secret

# Внутренние адреса заглушек-поставщиков
PROVIDER_A_URL=http://nginx/stubs/provider-a
PROVIDER_B_URL=http://nginx/stubs/provider-b

# Таймауты обращения и быстрые повторы внутри одной попытки выдачи
PROVIDER_CONNECT_TIMEOUT=1
PROVIDER_TIMEOUT=2
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_MS=200
